# Copy to .env for local runs and fill in. In Coolify set these as environment variables instead.
TG_API_KEY=
WEATHERAPI_KEY=
P_WEATHER_KEY=
BOT_ID=
CHAT_ID=
# Optional. Leave these commented unless you need them: an empty value (TZ= or DATA_DIR=)
# is still a value and overrides the image defaults (TZ=Europe/Lisbon, DATA_DIR=/data)
# under `docker run --env-file`, giving a UTC process or a crash on a root-owned /app/data.
# TZ=Europe/Lisbon
# DATA_DIR=./data
